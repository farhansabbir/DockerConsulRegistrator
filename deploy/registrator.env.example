# docker-consul-registrator's settings - for `docker run --env-file
# registrator.env` (Podman and nerdctl too) and for the stack (stack.yml).
# The filled-in copy holds secrets: keep it out of version control.
# Every setting is in `docker-consul-registrator --help`.

# Required: the Consul servers to join, comma-separated.
CONSUL_RETRY_JOIN=10.0.0.11,10.0.0.12,10.0.0.13

# The servers' datacenter (default dc1), and the DNS domain to serve the
# services in (default consul).
CONSUL_DATACENTER=dc1
CONSUL_DOMAIN=dmarts.app

# What marks a container, or a Swarm service, to register (default consul=yes).
REGISTRATOR_LABEL=consul=yes

# The cluster's gossip key, when its gossip is encrypted (consul keygen).
CONSUL_ENCRYPT=

# With the cluster's ACLs on: the agent's token and the registrator's
# (both needed), and the token anonymous DNS reads with. Any secret can
# come from a file instead, e.g. CONSUL_AGENT_TOKEN_FILE=/run/secrets/agent-token
CONSUL_AGENT_TOKEN=
CONSUL_HTTP_TOKEN=
CONSUL_DNS_TOKEN=
