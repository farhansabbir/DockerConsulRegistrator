# The bundled Consul agent's configuration - nothing secret here. The
# registrator adds the node name, its addresses and the DNS domain itself.
datacenter         = "dc1"                                  # your Consul datacenter
retry_join         = ["10.0.0.11", "10.0.0.12", "10.0.0.13"] # your Consul servers
client_addr        = "127.0.0.1"
leave_on_terminate = true

# DNS answers with healthy instances only.
dns_config { only_passing = true }

ports {
  grpc     = -1
  grpc_tls = -1
}

acl {
  enabled                  = true
  default_policy           = "deny"
  enable_token_persistence = true
}
