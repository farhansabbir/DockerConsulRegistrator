# The bundled Consul agent's secrets. Keep the copy you fill in out of
# version control (.gitignore leaves deploy/secrets.hcl out).
encrypt = "REPLACE with the cluster's gossip key (consul keygen)"

acl {
  tokens {
    # node_prefix "" write, service_prefix "" read
    agent = "REPLACE with the agents' token"
    # node_prefix, service_prefix and query_prefix "" read: anonymous DNS
    default = "REPLACE with the DNS token"
  }
}
